{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://stanislavmudra-hue.github.io/vareska-data/prices.schema.v2.json",
 "title": "Vareska price table v2 (one market)",
 "description": "Contract of docs/prices/<market>.json. One file per market (cz, sk, pl, de, at); prices are per kilogram in the market currency (litre for liquids; pieces are converted by the mapper via unitGrams). The store enum below is the union of every market's stores - the validator additionally checks that a file uses only the stores of its own market (pipeline/markets.py).",
 "type": "object",
 "additionalProperties": false,
 "required": ["v", "market", "currency", "updated", "perKg", "deals", "categoryFallbackPerKg"],
 "$defs": {
  "market": {"type": "string", "enum": ["cz", "sk", "pl", "de", "at"]},
  "currency": {"type": "string", "enum": ["CZK", "EUR", "PLN"]},
  "store": {
   "type": "string",
   "enum": ["albert", "aldi", "aldiNord", "aldiSued", "auchan", "biedronka", "billa", "carrefour", "coopJednota", "dino", "edeka", "fresh", "globus", "hofer", "interspar", "kaufland", "lidl", "mpreis", "netto", "norma", "penny", "rewe", "spar", "terno", "tesco", "zabka"]
  },
  "isoDate": {
   "type": "string",
   "pattern": "^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])$"
  },
  "price": {
   "type": "number",
   "exclusiveMinimum": 0,
   "maximum": 50000
  },
  "ingredientId": {
   "type": "string",
   "pattern": "^[a-z0-9_]+$",
   "minLength": 1,
   "maxLength": 64
  }
 },
 "properties": {
  "v": {"const": 2},
  "market": {"$ref": "#/$defs/market"},
  "currency": {"$ref": "#/$defs/currency"},
  "updated": {"$ref": "#/$defs/isoDate"},
  "perKg": {
   "type": "object",
   "propertyNames": {"$ref": "#/$defs/ingredientId"},
   "additionalProperties": {
    "type": "object",
    "propertyNames": {"$ref": "#/$defs/store"},
    "additionalProperties": {"$ref": "#/$defs/price"},
    "minProperties": 1
   }
  },
  "deals": {
   "type": "array",
   "maxItems": 5000,
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["ingredientId", "store", "perKg", "validFrom", "validTo", "title"],
    "properties": {
     "ingredientId": {"$ref": "#/$defs/ingredientId"},
     "store": {"$ref": "#/$defs/store"},
     "perKg": {"$ref": "#/$defs/price"},
     "validFrom": {"$ref": "#/$defs/isoDate"},
     "validTo": {"$ref": "#/$defs/isoDate"},
     "title": {"type": "string", "minLength": 1, "maxLength": 120}
    }
   }
  },
  "categoryFallbackPerKg": {
   "type": "object",
   "propertyNames": {
    "enum": ["vegetable", "fruit", "herb", "spice", "meat", "poultry", "fish", "seafood", "dairy", "egg", "grain", "pasta", "bakery", "legume", "nut", "oil", "sweetener", "condiment", "alcohol", "beverage", "other"]
   },
   "additionalProperties": {"$ref": "#/$defs/price"}
  }
 }
}
